{
  "name": "smugless",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Open-source photo portfolio website with a built-in admin, nearly free to host on Cloudflare Workers, R2 and Images",
  "scripts": {
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tail": "wrangler tail",
    "deploy:demo": "wrangler deploy --env demo",
    "tail:demo": "wrangler tail --env demo",
    "deploy:demo-proxy": "cd demo-proxy && wrangler pages deploy --branch main"
  },
  "dependencies": {
    "hono": "^4.13.18",
    "jose": "^6.2.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "photoswipe": "^5.4.4",
    "sortablejs": "^1.15.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.162.0"
  },
  "license": "MIT"
}
