{
  // LaPlante Photography production site. Kept in its own file (not wrangler.jsonc)
  // so upstream changes to wrangler.jsonc merge without conflicts.
  //   npm run deploy:laplante
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laplante-photography",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public" },
  // Private bucket: originals/, derived/ (resized cache), trash/, manifest.json
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "laplante-photos" }],
  "images": { "binding": "IMAGES" },
  // Per-IP cap on admin sign-in attempts (see src/security.ts). namespace_id is any
  // integer unique within the Cloudflare account.
  "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "vars": {
    // Scripts sign in with the form (scripts/import.mjs), so Basic auth isn't needed.
    "ADMIN_BASIC_AUTH": "off"
    // To use Google sign-in instead of a password (recommended), add:
    // "ADMIN_AUTH": "google",
    // "GOOGLE_CLIENT_ID": "<id>.apps.googleusercontent.com"
    // and set GOOGLE_CLIENT_SECRET and GOOGLE_ADMIN_EMAIL as secrets with `wrangler secret put`
    // (this repository is public, so keep the admin's email address out of this file).
  },
  "observability": { "enabled": true }
  // Once the domain is on Cloudflare, serve the site there and turn off the workers.dev URL:
  // "routes": [{ "pattern": "www.example.com", "custom_domain": true }],
  // "workers_dev": false,
  // "preview_urls": false
}
