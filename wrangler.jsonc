{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smugless",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Static files (CSS, JS, vendored libraries). Anything not matching a file falls through to the Worker.
  "assets": { "directory": "./public" },
  // Private bucket: originals/, derived/ (resized cache), trash/, manifest.json
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "smugless-photos" }],
  // Cloudflare Images binding, used to resize originals on first request
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true },
  // Per-IP limit on admin password checks (sign-in form and HTTP Basic): 10 a minute.
  // namespace_id is any number unique within your Cloudflare account.
  "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // Secret (set with `wrangler secret put ADMIN_PASSWORD`): password for /admin

  "env": {
    // Public demo with Unsplash photos: `npm run deploy:demo`. Separate Worker
    // (smugless-demo), bucket and ADMIN_PASSWORD secret, so it never touches production.
    "demo": {
      "name": "smugless-demo",
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "smugless-demo-photos" }],
      "images": { "binding": "IMAGES" },
      "observability": { "enabled": true },
      "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }]
    }
  }
}
